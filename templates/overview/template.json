{
  "id": "overview",
  "title": "$project",
  "params": [],
  "sections": [
    {
      "id": "what-this-is",
      "kind": "llm",
      "heading": "What this is",
      "prompt": "prompts/what-this-is.md",
      "requires": [
        "run-context",
        "features",
        "screens",
        "map-edges",
        "reliability",
        "evidence:readme-section"
      ],
      "contract": { "maxWords": 750, "maxHeadingLevel": 3 }
    },
    {
      "id": "map",
      "kind": "code",
      "heading": "How it fits together",
      "fragment": "project-map",
      "requires": ["run-context", "map-edges"]
    },
    {
      "id": "capabilities",
      "kind": "llm",
      "heading": "What it does",
      "prompt": "prompts/capabilities.md",
      "requires": ["capability-index"],
      "contract": { "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "access",
      "kind": "llm",
      "heading": "Who uses it, and how access is controlled",
      "prompt": "prompts/access.md",
      "requires": ["screens", "auth-annotations", "endpoints", "map-edges", "run-context"],
      "contract": { "maxWords": 600, "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "data-ownership",
      "kind": "llm",
      "heading": "The data it owns, and what it shares",
      "prompt": "prompts/data-ownership.md",
      "requires": ["data-ownership", "entities", "run-context"],
      "contract": { "maxWords": 700, "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "connections",
      "kind": "code",
      "heading": "What it connects to",
      "fragment": "external-systems",
      "requires": ["map-edges"],
      "omitWhenEmpty": true
    },
    {
      "id": "operational",
      "kind": "llm",
      "heading": "How it runs, and how it copes with failure",
      "prompt": "prompts/operational.md",
      "requires": ["reliability", "dependencies", "run-context"],
      "contract": { "maxWords": 600, "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "issues",
      "kind": "llm",
      "heading": "What is wrong with it",
      "prompt": "prompts/issues.md",
      "requires": [
        "structural-findings",
        "signals",
        "data-ownership",
        "reliability",
        "feature-findings",
        "run-context"
      ],
      "contract": { "maxWords": 850, "maxHeadingLevel": 3 }
    },
    {
      "id": "limitations",
      "kind": "code",
      "heading": "What this report cannot tell you",
      "fragment": "limitations",
      "requires": ["coverage-notes", "extraction-failures"]
    }
  ]
}
