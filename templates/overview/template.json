{
  "id": "overview",
  "title": "$project",
  "params": [],
  "sections": [
    {
      "id": "what-this-is",
      "kind": "llm",
      "heading": "What this is",
      "prompt": "prompts/what-this-is.md",
      "requires": [
        "run-context",
        "features",
        "screens",
        "map-edges",
        "evidence:readme-section"
      ],
      "contract": {
        "maxWords": 600,
        "maxHeadingLevel": 3
      }
    },
    {
      "id": "map",
      "kind": "code",
      "heading": "How it fits together",
      "fragment": "project-map",
      "requires": [
        "run-context",
        "map-edges"
      ]
    },
    {
      "id": "capabilities",
      "kind": "llm",
      "heading": "What it does",
      "prompt": "prompts/capabilities.md",
      "requires": [
        "capability-index"
      ],
      "contract": {
        "maxHeadingLevel": 3
      },
      "omitWhenEmpty": true
    },
    {
      "id": "connections",
      "kind": "code",
      "heading": "What it connects to",
      "fragment": "external-systems",
      "requires": [
        "map-edges"
      ],
      "omitWhenEmpty": true
    },
    {
      "id": "data",
      "kind": "code",
      "heading": "What it remembers",
      "fragment": "stored-kinds",
      "requires": [
        "entities",
        "coverage:entity"
      ]
    },
    {
      "id": "issues",
      "kind": "llm",
      "heading": "What is wrong with it",
      "prompt": "prompts/issues.md",
      "requires": [
        "structural-findings",
        "signals",
        "run-context"
      ],
      "contract": {
        "maxWords": 500,
        "maxHeadingLevel": 3
      }
    },
    {
      "id": "limitations",
      "kind": "code",
      "heading": "What this report cannot tell you",
      "fragment": "limitations",
      "requires": [
        "coverage-notes",
        "extraction-failures"
      ]
    }
  ]
}
