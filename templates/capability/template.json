{
  "id": "capability",
  "title": "$capability",
  "params": ["capability"],
  "sections": [
    {
      "id": "what-this-is",
      "kind": "llm",
      "heading": "What this is",
      "prompt": "prompts/what-this-is.md",
      "requires": ["feature-detail:$capability", "feature-flows:$capability"],
      "contract": { "maxWords": 600, "maxHeadingLevel": 3 }
    },
    {
      "id": "journey",
      "kind": "llm",
      "heading": "What happens when you use it",
      "prompt": "prompts/journey.md",
      "requires": [
        "feature-flows:$capability",
        "feature-decisions:$capability",
        "feature-rules:$capability"
      ],
      "contract": { "maxWords": 800, "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "flow",
      "kind": "llm",
      "heading": "The logic, drawn",
      "prompt": "prompts/flow.md",
      "requires": [
        "feature-decisions:$capability",
        "feature-rules:$capability",
        "feature-flows:$capability",
        "value-sets"
      ],
      "contract": { "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "rules",
      "kind": "llm",
      "heading": "The rules it enforces",
      "prompt": "prompts/rules.md",
      "requires": ["feature-rules:$capability"],
      "contract": { "maxWords": 800, "maxHeadingLevel": 3 },
      "omitWhenEmpty": true
    },
    {
      "id": "data",
      "kind": "code",
      "heading": "What it remembers",
      "fragment": "capability-data",
      "requires": ["feature-detail:$capability", "coverage:entity"],
      "omitWhenEmpty": true
    },
    {
      "id": "issues",
      "kind": "llm",
      "heading": "What is wrong with it",
      "prompt": "prompts/issues.md",
      "requires": ["feature-findings-for:$capability", "feature-rules:$capability"],
      "contract": { "maxWords": 600, "maxHeadingLevel": 3 }
    },
    {
      "id": "limitations",
      "kind": "code",
      "heading": "What this report cannot tell you",
      "fragment": "limitations",
      "requires": ["coverage-notes", "extraction-failures"]
    }
  ]
}
